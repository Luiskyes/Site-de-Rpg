# Local: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Neon: use a URL com pool (`-pooler`) e `sslmode=require` em Neon > Connect.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_POOL_MAX=5
JWT_SECRET=replace-with-a-long-random-secret
MASTER_EMAILS=master@example.com
APP_URL=http://localhost:3000

# Google Identity Services (OAuth 2.0 Client ID do tipo Web)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Recuperação de senha por e-mail com Resend
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=Keys Lock <noreply@example.com>
